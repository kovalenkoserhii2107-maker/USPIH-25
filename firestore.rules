rules_version = '2';

// ============================================================
// ПРАВИЛА ДОСТУПУ ОСББ «Успіх-25»
//
// ВАЖЛИВО: саме ці правила, а не код у браузері, реально
// захищають дані. JavaScript можна обійти через DevTools;
// правила — ні. Скопіюйте цей файл у:
//   Firebase Console → Firestore Database → Rules → Publish
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Номер квартири поточного користувача (з email виду "45@uspih-25.com")
    function myApt() {
      return request.auth.token.email.split('@')[0];
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/apartments/$(myApt()))
        && get(/databases/$(database)/documents/apartments/$(myApt())).data.isAdmin == true;
    }

    // Посилання на файл у сховищі саме цього застосунку. Без цієї
    // перевірки мешканець міг би підкласти у «вкладення» посилання
    // на сторонній сайт — і сусіди відкривали б його як файл ОСББ.
    function isOwnFileUrl(u) {
      return u is string
        && u.matches('https://firebasestorage[.]googleapis[.]com/v0/b/uspih-25[.](firebasestorage[.]app|appspot[.]com)/o/.*');
    }

    function isOwnFile(f) {
      return f is map && isOwnFileUrl(f.get('url', null));
    }

    // Правила не вміють циклів, тож перевіряємо кожну позицію окремо.
    // && зупиняється на першому false, тож до неіснуючих елементів
    // справа не доходить.
    function okAttachments(list) {
      return list is list && list.size() <= 10
        && (list.size() < 1 || isOwnFile(list[0]))
        && (list.size() < 2 || isOwnFile(list[1]))
        && (list.size() < 3 || isOwnFile(list[2]))
        && (list.size() < 4 || isOwnFile(list[3]))
        && (list.size() < 5 || isOwnFile(list[4]))
        && (list.size() < 6 || isOwnFile(list[5]))
        && (list.size() < 7 || isOwnFile(list[6]))
        && (list.size() < 8 || isOwnFile(list[7]))
        && (list.size() < 9 || isOwnFile(list[8]))
        && (list.size() < 10 || isOwnFile(list[9]));
    }

    // Цитата, на яку відповідають: лише службові поля й короткий текст
    function okReplyTo(r) {
      return r == null
        || (r is map
            && r.keys().hasOnly(['id', 'apt', 'isBoard', 'text'])
            && r.get('text', '') is string
            && r.get('text', '').size() <= 200);
    }

    // Спільне для нового повідомлення в чаті й коментаря
    function okChatPost(d) {
      return d.keys().hasOnly(['apt', 'isBoard', 'text', 'attachments', 'replyTo', 'createdAt'])
        && d.apt == myApt()
        && d.isBoard is bool
        && d.text is string
        && d.text.size() > 0
        && d.text.size() <= 2000
        && okAttachments(d.get('attachments', []))
        && okReplyTo(d.get('replyTo', null))
        && d.createdAt == request.time;
    }

    // ---------- КВАРТИРИ ----------
    // Мешканець бачить і редагує ТІЛЬКИ свою квартиру.
    match /apartments/{apt} {
      allow read: if isSignedIn() && (apt == myApt() || isAdmin());

      // Мешканець змінює у своїй квартирі рівно те, що є його власною
      // дією: пароль змінено, список власників підтверджено, тур пройдено.
      //
      // Раніше тут дозволялося все, крім isAdmin. Тобто мешканець міг
      // виправити собі площу — а вона входить у кворум за площею — або
      // обнулити власний борг. Ці поля веде бухгалтерія, не мешканець.
      allow update: if isSignedIn() && apt == myApt()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['passwordChanged', 'ownersStatus', 'ownersConfirmedAt',
                       'ownersConfirmedBy', 'tutorialAt', 'termsAcceptedAt'])
        // «Підтвердило правління» мешканець про себе написати не може
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownersConfirmedBy'])
            || request.resource.data.ownersConfirmedBy == 'apt')
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownersStatus'])
            || request.resource.data.ownersStatus in ['confirmed', 'review']);

      allow create: if isSignedIn() && apt == myApt()
                    && request.resource.data.isAdmin == false;
      allow write: if isAdmin();

      // Список співвласників мешканець тільки читає.
      //
      // Досі він міг його й писати — тобто дописати собі співвласника,
      // а отже й голос: кворум рахує унікальних власників. Тепер будь-яка
      // правка йде заявкою в owner_changes, і її розглядає правління.
      match /owners/{ownerId} {
        allow read: if isSignedIn() && (apt == myApt() || isAdmin());
        allow write: if isAdmin();
      }

      // Заявка на зміну списку власників.
      match /owner_changes/{changeId} {
        allow read: if isSignedIn() && (apt == myApt() || isAdmin());
        allow create: if isSignedIn() && apt == myApt()
                      && request.resource.data.status == 'pending'
                      && request.resource.data.reason is string
                      && request.resource.data.reason.size() <= 1000;
        // Рішення за заявкою ухвалює лише правління
        allow update, delete: if isAdmin();
      }

      // Квитанції: мешканець бачить лише свої, виставляє їх бухгалтер
      match /receipts/{receiptId} {
        allow read: if isSignedIn() && (apt == myApt() || isAdmin());
        allow write: if isAdmin();
      }

      // Історія нарахувань і оплат — те саме право, що й у квитанцій:
      // мешканець читає лише свою, вносить її правління вивантаженням.
      match /ledger/{entryId} {
        allow read: if isSignedIn() && (apt == myApt() || isAdmin());
        allow write: if isAdmin();
      }

      // Версія особистих показників: захищає від паралельного перезапису.
      match /meter_state/{stateId} {
        allow read: if isSignedIn() && (apt == myApt() || isAdmin());
        allow create, update: if isSignedIn() && apt == myApt() && stateId == 'current'
          && request.resource.data.keys().hasOnly(['revision', 'updatedAt'])
          && request.resource.data.revision is int
          && request.resource.data.revision == (resource == null ? 1 : resource.data.revision + 1)
          && request.resource.data.updatedAt == request.time;
        allow write: if isAdmin();
      }
    }

    // Квартирні показники приватні. Загальнобудинковий облік лишається у status.
    match /apartment_meter_readings/{readingId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.apt == myApt());
      allow get: if isSignedIn() && resource == null && readingId.split('_').size() == 3
                 && readingId.split('_')[0] == myApt()
                 && readingId.split('_')[1] in ['electricity', 'water']
                 && readingId.split('_')[2].matches('[0-9]{4}-(0[1-9]|1[0-2])');
      function okMeterChannel(c) {
        // Межа показника перевіряється за сумою в документі.
        return c.keys().hasOnly(['name', 'reading', 'baseline', 'reset', 'note'])
          && c.name.matches('(?s).{1,60}')
          && c.reading is int
          && c.baseline >= 0 && c.baseline <= c.reading
          && c.reset is bool && c.note.matches('(?s).{0,500}');
      }
      function okWaterChannels(data, channels) {
        let values = channels.values();
        let count = values.size();
        return channels.keys().hasOnly(['main', 'water2', 'water3', 'water4', 'water5', 'water6', 'water7', 'water8'])
          && (count < 1 || okMeterChannel(values[0]))
          && (count < 2 || okMeterChannel(values[1]))
          && (count < 3 || okMeterChannel(values[2]))
          && (count < 4 || okMeterChannel(values[3]))
          && (count < 5 || okMeterChannel(values[4]))
          && (count < 6 || okMeterChannel(values[5]))
          && (count < 7 || okMeterChannel(values[6]))
          && (count < 8 || okMeterChannel(values[7]))
          && data.reading == (count < 1 ? 0 : values[0].reading) + (count < 2 ? 0 : values[1].reading) + (count < 3 ? 0 : values[2].reading) + (count < 4 ? 0 : values[3].reading) + (count < 5 ? 0 : values[4].reading) + (count < 6 ? 0 : values[5].reading) + (count < 7 ? 0 : values[6].reading) + (count < 8 ? 0 : values[7].reading)
          && data.baseline == (count < 1 ? 0 : values[0].baseline) + (count < 2 ? 0 : values[1].baseline) + (count < 3 ? 0 : values[2].baseline) + (count < 4 ? 0 : values[3].baseline) + (count < 5 ? 0 : values[4].baseline) + (count < 6 ? 0 : values[5].baseline) + (count < 7 ? 0 : values[6].baseline) + (count < 8 ? 0 : values[7].baseline);
      }
      function okElectricityChannels(d, c) {
        return (c.size() == 1 && c.keys().hasAll(['main']) && okMeterChannel(c.main)
                && d.reading == c.main.reading && d.baseline == c.main.baseline)
          || (c.size() == 2 && c.keys().hasAll(['day', 'night'])
              && okMeterChannel(c.day) && okMeterChannel(c.night)
              && d.reading == c.day.reading + c.night.reading && d.baseline == c.day.baseline + c.night.baseline);
      }
      function validApartmentReading() {
        let d = request.resource.data;
        let channels = d.get('channels', {});
        let apt = myApt();
        let state = /databases/$(database)/documents/apartments/$(apt)/meter_state/current;
        return d.keys().hasOnly(['kind', 'apt', 'resource', 'period', 'unit', 'reading', 'baseline', 'reset', 'note',
                                'revision', 'createdAt', 'updatedAt', 'updatedBy', 'channels'])
          && d.kind == 'apartmentMeterReading' && d.apt == apt
          && readingId == apt + '_' + d.resource + '_' + d.period
          && d.resource in ['electricity', 'water']
          && d.period.matches('[0-9]{4}-(0[1-9]|1[0-2])')
          && d.unit == (d.resource == 'electricity' ? 'кВт·год' : 'м³')
          && d.reading <= 10000000000
          && d.reset is bool && d.note.matches('(?s).{0,500}')
          // Для набору приладів типи й межі визначають перевірені суми каналів.
          && ('channels' in d ? (channels is map && channels.size() > 0
                && (d.resource == 'electricity' ? okElectricityChannels(d, channels) : okWaterChannels(d, channels)))
              : (d.reading is number && d.reading >= 0
                  && d.baseline is number && d.baseline >= 0 && d.baseline <= d.reading))
          && d.updatedBy == apt && d.updatedAt == request.time
          && d.revision is int && d.revision == getAfter(state).data.revision
          && d.revision == (exists(state) ? get(state).data.revision + 1 : 1)
          && (resource == null ? d.createdAt == request.time
              : resource.data.apt == apt && d.createdAt == resource.data.createdAt);
      }
      allow create, update: if isSignedIn() && validApartmentReading();
      allow write: if isAdmin();
    }

    // Черга заявок на зміну списків власників — теж одним запитом.
    match /{path=**}/owner_changes/{changeId} {
      allow read: if isAdmin();
    }

    // Правління читає всіх співвласників одним collectionGroup-запитом
    // для довідника квартир. Мешканців це не стосується: їхній доступ
    // до власної квартири лишається правилом вище.
    match /{path=**}/owners/{ownerId} {
      allow read: if isAdmin();
    }

    // ---------- ПОВІДОМЛЕННЯ ----------
    // Читати можна лише те, де ти є серед адресатів.
    // Саме тому клієнт робить запит array-contains-any по recipients.
    match /messages/{msgId} {
      allow read: if isAdmin()
        || (isSignedIn() && (
              'all' in resource.data.recipients
              || ('apt:' + myApt()) in resource.data.recipients
              || resource.data.recipients.hasAny(['ent:' + string(
                   get(/databases/$(database)/documents/apartments/$(myApt())).data.entrance)])
           ));

      allow create, delete: if isAdmin();

      // Мешканець може лише позначити прочитання своєї квартири
      allow update: if isAdmin()
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
            && request.resource.data.readBy.diff(resource.data.readBy)
                 .affectedKeys().hasOnly([myApt()]));

      // Коментарі — лише під оголошеннями для всього будинку.
      // Під адресним повідомленням вони відкрили б чужу переписку
      // тим, кому саме оголошення не призначалося.
      match /comments/{commentId} {
        allow read: if isSignedIn()
          && 'all' in get(/databases/$(database)/documents/messages/$(msgId)).data.recipients;

        allow create: if isSignedIn()
          && okChatPost(request.resource.data)
          && request.resource.data.get('attachments', []).size() == 0
          && (request.resource.data.isBoard == false || isAdmin())
          && 'all' in get(/databases/$(database)/documents/messages/$(msgId)).data.recipients;

        // Видалення тепер мʼяке: документ лишається з міткою, щоб у
        // розмові було видно, що тут щось було. Тому дозволяємо
        // update, але суворо обмежуємо, ЩО саме можна змінити.
        allow update: if isSignedIn()
          && resource.data.get('deleted', false) == false
          && (
            // автор виправляє власний текст
            (resource.data.apt == myApt()
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['text', 'editedAt'])
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 2000)
            ||
            // мʼяке видалення: автор або правління. Вміст затирається,
            // лишається сама мітка.
            ((resource.data.apt == myApt() || isAdmin())
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['deleted', 'deletedAt', 'deletedByBoard', 'text', 'attachments'])
              && request.resource.data.deleted == true)
          );

        // Остаточно стерти може лише правління — на випадок,
        // коли навіть мітка недоречна.
        allow delete: if isAdmin();
      }
    }

    // ---------- ЧАТ БУДИНКУ ----------
    match /chat/{msgId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        // писати можна лише від своєї квартири, лише відомі поля,
        // вкладення — лише з нашого сховища
        && okChatPost(request.resource.data)
        // Позначку «від правління» може поставити лише правління.
        // Записано так, а не через isBoard == isAdmin(): у звичайного
        // мешканця перший доданок істинний одразу, і Firestore не
        // читає документ квартири заради кожного повідомлення.
        && (request.resource.data.isBoard == false || isAdmin());

        // Видалення тепер мʼяке: документ лишається з міткою, щоб у
      // розмові було видно, що тут щось було. Тому дозволяємо
      // update, але суворо обмежуємо, ЩО саме можна змінити.
      allow update: if isSignedIn()
        && resource.data.get('deleted', false) == false
        && (
          // автор виправляє власний текст
          (resource.data.apt == myApt()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['text', 'editedAt'])
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 2000)
          ||
          // мʼяке видалення: автор або правління. Вміст затирається,
          // лишається сама мітка.
          ((resource.data.apt == myApt() || isAdmin())
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['deleted', 'deletedAt', 'deletedByBoard', 'text', 'attachments'])
            && request.resource.data.deleted == true)
        );

      // Остаточно стерти може лише правління — на випадок,
      // коли навіть мітка недоречна.
      allow delete: if isAdmin();
    }

    // ---------- ЗВЕРНЕННЯ ----------
    match /requests/{reqId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.apt == myApt());
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasOnly(['apt', 'text', 'attachments', 'status', 'createdAt'])
                    && request.resource.data.apt == myApt()
                    && request.resource.data.status == 'new'
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 5000
                    && okAttachments(request.resource.data.get('attachments', []))
                    && request.resource.data.createdAt == request.time;
      // Відповідати може лише правління
      allow update, delete: if isAdmin();
    }

    // ---------- БАЗА ДОКУМЕНТІВ ОСББ ----------
    match /osbb_documents/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------- СТАТУС СВІТЛА ----------
    match /status/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------- ГОЛОСУВАННЯ ----------
    match /polls/{pollId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();

      // Електронний і старий паперовий голос: votes/{номер квартири}.
      // Новий паперовий голос співвласника: votes/owner:{квартира}:{ownerId}
      // (сегменти ID кодуються encodeURIComponent у застосунку).
      match /votes/{voteId} {
        allow read: if isSignedIn();

        function validMeetingAnswers(data) {
          return data.answers is map
            && data.answers.size() > 0
            && data.answers.values().hasOnly(['За', 'Проти', 'Утримався']);
        }

        // Кожний співвласник має власну мапу відповідей. Паперові
        // голоси вносить тільки правління, зокрема до початку зборів.
        function validOwnerPaperVote() {
          let data = request.resource.data;
          return voteId.matches('owner:[^:]+:[^:]+')
            && data.keys().hasOnly(['apt', 'ownerId', 'answers', 'source', 'enteredBy', 'votedAt'])
            && data.apt is string && data.apt.size() > 0
            && data.ownerId is string && data.ownerId.size() > 0
            && data.source == 'paper'
            && data.get('enteredBy', '') is string
            && data.get('votedAt', request.time) is timestamp
            && get(/databases/$(database)/documents/polls/$(pollId)).data.get('isMeeting', false) == true
            && validMeetingAnswers(data);
        }

        // Старі голоси квартири лишаються доступними правлінню.
        // Нові індивідуальні документи перевіряються окремо.
        allow create, update: if isAdmin()
          && (!('ownerId' in request.resource.data) || validOwnerPaperVote());

        function validResidentVote() {
          let data = request.resource.data;
          let poll = get(/databases/$(database)/documents/polls/$(pollId)).data;
          return voteId == myApt()
            && data.votedAt == request.time
            && poll.status == 'active'
            && (poll.get('deadline', null) == null || request.time < poll.deadline)
            && (poll.get('votingOpensAt', null) == null || request.time >= poll.votingOpensAt)
            && (
              // Звичайне опитування — один із його варіантів.
              (poll.get('isMeeting', false) != true
                && data.keys().hasOnly(['option', 'votedAt'])
                && data.option in poll.options)
              ||
              // Збори — тільки відповіді. Поля apt, ownerId, source
              // та enteredBy мешканцю записувати заборонено.
              (poll.get('isMeeting', false) == true
                && data.keys().hasOnly(['answers', 'votedAt'])
                && validMeetingAnswers(data))
            );
        }

        allow create, update: if isSignedIn() && validResidentVote();
        allow delete: if isAdmin();
      }
    }

    // ---------- ЖУРНАЛ СВІТЛА ----------
    // Кожне перемикання лишає запис — інакше статистику відключень
    // не буде з чого рахувати. Правити минуле не можна нікому:
    // журнал лише поповнюється.
    match /power_log/{entryId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ---------- ПЛАТІЖНІ РЕКВІЗИТИ ОСББ ----------
    // Читають усі мешканці — без реквізитів немає як заплатити.
    match /osbb_settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------- ЗВІТ ПРО ВИТРАТИ ----------
    // Публічний для мешканців: у цьому й сенс прозорості.
    match /finance/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------- ТЕХНІЧНІ СЛУЖБИ ----------
    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------- КОНТАКТИ ПРАВЛІННЯ ----------
    match /board_members/{memberId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}

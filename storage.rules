rules_version = '2';

// Скопіюйте весь файл у Firebase Console → Storage → Rules → Publish.
// Бакет застосунку: uspih-25.firebasestorage.app.
// Це правила файлів; firestore.rules регулює лише документи бази даних.
// Для перевірки прав правління Storage має отримати доступ до Firestore:
// якщо Firebase Console пропонує надати цей дозвіл, надайте його.

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null && request.auth.token.email is string;
    }

    function myApt() {
      return request.auth.token.email.split('@')[0];
    }

    // Роль із staff/{номер входу}, як у firestore.rules. Старий спільний
    // обліковий запис правління (isAdmin) без документа в staff діє як
    // голова, доки голова не вимкне його в «Команді».
    function role() {
      let staff = /databases/(default)/documents/staff/$(myApt());
      let apt = /databases/(default)/documents/apartments/$(myApt());
      return !signedIn() ? 'none'
        : firestore.exists(staff)
          ? (firestore.get(staff).data.active == true ? firestore.get(staff).data.role : 'none')
        : (firestore.exists(apt) && firestore.get(apt).data.get('isAdmin', false) == true) ? 'chair' : 'none';
    }

    // Будь-хто з команди правління.
    function admin() {
      return role() in ['chair', 'board', 'accountant'];
    }

    // Голова й члени правління: збори, документи квартир, контакти.
    function manager() {
      return role() in ['chair', 'board'];
    }

    // Голова й бухгалтер: квитанції.
    function accountant() {
      return role() in ['chair', 'accountant'];
    }

    function safeUpload(maxMb) {
      return request.resource.size < maxMb * 1024 * 1024
        && request.resource.contentType is string;
    }

    match /requests/{apt}/{file=**} {
      allow read: if signedIn() && (apt == myApt() || admin());
      allow create, update: if signedIn() && (apt == myApt() || admin()) && safeUpload(15);
      allow delete: if admin();
    }

    match /replies/{requestId}/{file=**} {
      allow read: if signedIn();
      allow create, update, delete: if admin() && (request.resource == null || safeUpload(15));
    }

    match /chat/{apt}/{file=**} {
      allow read: if signedIn();
      allow create, update: if signedIn() && apt == myApt() && safeUpload(15);
      allow delete: if manager() || (signedIn() && apt == myApt());
    }

    match /apartments/{apt}/{file=**} {
      allow read: if signedIn() && (apt == myApt() || admin());
      allow create, update: if signedIn() && (apt == myApt() || manager()) && safeUpload(15);
      allow delete: if manager();
    }

    match /receipts/{apt}/{file=**} {
      allow read: if signedIn() && (apt == myApt() || admin());
      allow write: if accountant() && (request.resource == null || safeUpload(20));
    }

    match /messages/{file=**} {
      allow read: if signedIn();
      allow write: if admin() && (request.resource == null || safeUpload(20));
    }

    // Матеріали загальних зборів та опитувань: PDF, Word, Excel, фото.
    // Правління завантажує файли до створення документа зборів,
    // тому тут не вимагаємо існування polls/{id}.
    match /polls/{file=**} {
      allow read: if signedIn();
      allow create, update: if manager() && safeUpload(20);
      allow delete: if manager();
    }

    // Протоколи правління, протоколи загальних зборів і документи Бази.
    // Тип документа не обмежуємо: браузер може не визначити MIME Word/Excel.
    match /osbb_docs/{file=**} {
      allow read: if signedIn();
      allow create, update: if admin() && safeUpload(30);
      allow delete: if admin();
    }

    match /board_members/{file=**} {
      allow read: if signedIn();
      allow write: if manager() && (request.resource == null || safeUpload(8));
    }

    match /services/{file=**} {
      allow read: if signedIn();
      allow write: if manager() && (request.resource == null || safeUpload(8));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

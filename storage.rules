rules_version = '2';

// Скопіюйте весь файл у Firebase Console → Storage → Rules → Publish.
// Бакет застосунку: uspih-25.firebasestorage.app.
// Це правила файлів; firestore.rules регулює лише документи бази даних.
// Для перевірки прав правління Storage має отримати доступ до Firestore:
// якщо Firebase Console пропонує надати цей дозвіл, надайте його.

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null && request.auth.token.email is string && validApartmentSession();
    }
    function validApartmentSession() {
      let apt = /databases/(default)/documents/apartments/$(request.auth.token.email.split('@')[0]);
      return (!firestore.exists(apt)
          || request.auth.uid == firestore.get(apt).data.get('authKeeperUid', '')
          || request.auth.token.get('auth_time', 0) > firestore.get(apt).data.get('authAfter', -1));
    }

    function myApt() {
      return request.auth.token.email.split('@')[0];
    }

    // Роль із staff/{номер входу}, як у firestore.rules. Старий спільний
    // обліковий запис правління (isAdmin) без документа в staff діє як
    // голова, доки голова не вимкне його в «Команді».
    function role() {
      let staff = /databases/(default)/documents/staff/$(myApt());
      let apt = /databases/(default)/documents/apartments/$(myApt());
      return !signedIn() ? 'none'
        : firestore.exists(staff)
          ? (firestore.get(staff).data.active == true ? firestore.get(staff).data.role : 'none')
        : (firestore.exists(apt) && firestore.get(apt).data.get('isAdmin', false) == true) ? 'chair' : 'none';
    }

    // Будь-хто з команди правління.
    function admin() {
      return role() in ['chair', 'board', 'accountant'];
    }

    // Голова й члени правління: збори, документи квартир, контакти.
    function manager() {
      return role() in ['chair', 'board'];
    }

    // Голова й бухгалтер: квитанції.
    function accountant() {
      return role() in ['chair', 'accountant'];
    }

    function writeEnabled() {
      let apt = /databases/(default)/documents/apartments/$(myApt());
      let staff = /databases/(default)/documents/staff/$(myApt());
      return signedIn()
        && (firestore.exists(apt) || firestore.exists(staff))
        && (!firestore.exists(apt) || !firestore.get(apt).data.get('_resetBlocked', false))
        && (!firestore.exists(staff) || !firestore.get(staff).data.get('_resetBlocked', false));
    }

    function safeUpload(maxMb) {
      return request.resource.size < maxMb * 1024 * 1024
        && request.resource.contentType is string;
    }

    match /requests/{apt}/{file=**} {
      allow read: if signedIn() && (apt == myApt() || admin());
      allow create, update: if writeEnabled() && (signedIn() && (apt == myApt() || admin()) && safeUpload(15));
      allow delete: if writeEnabled() && (admin());
    }

    match /replies/{requestId}/{file=**} {
      allow read: if signedIn();
      allow create, update, delete: if writeEnabled() && (admin() && (request.resource == null || safeUpload(15)));
    }

    match /chat/{apt}/{file=**} {
      allow read: if signedIn();
      allow create, update: if writeEnabled() && (signedIn() && apt == myApt() && safeUpload(15));
      allow delete: if writeEnabled() && (manager() || (signedIn() && apt == myApt()));
    }

    match /apartments/{apt}/{file=**} {
      allow read: if signedIn() && (apt == myApt() || admin());
      allow create, update: if writeEnabled() && (signedIn() && (apt == myApt() || manager()) && safeUpload(15));
      allow delete: if writeEnabled() && (manager());
    }

    // Рахунки, акти, накладні й договори. Завантажують голова й
    // бухгалтер; документ у базі створює сервер (expenseAction).
    match /expenses/{file=**} {
      allow read: if accountant();
      allow create, update: if writeEnabled() && (accountant() && safeUpload(20));
      allow delete: if writeEnabled() && (accountant());
    }

    // Звіти ДПС: XML, PDF, квитанції № 1 і № 2 (запис у базу — сервер).
    match /reports/{key}/{file=**} {
      allow read: if accountant();
      allow create: if writeEnabled() && (accountant() && safeUpload(10));
    }

    match /receipts/{apt}/{file=**} {
      allow read: if signedIn() && (apt == myApt() || admin());
      allow write: if writeEnabled() && (accountant() && (request.resource == null || safeUpload(20)));
    }

    match /messages/{file=**} {
      allow read: if signedIn();
      allow write: if writeEnabled() && (admin() && (request.resource == null || safeUpload(20)));
    }

    // Матеріали загальних зборів та опитувань: PDF, Word, Excel, фото.
    // Правління завантажує файли до створення документа зборів,
    // тому тут не вимагаємо існування polls/{id}.
    match /polls/{file=**} {
      allow read: if signedIn();
      allow create, update: if writeEnabled() && (manager() && safeUpload(20));
      allow delete: if writeEnabled() && (manager());
    }

    // Протоколи правління, протоколи загальних зборів і документи Бази.
    // Тип документа не обмежуємо: браузер може не визначити MIME Word/Excel.
    match /osbb_docs/{file=**} {
      allow read: if signedIn();
      allow create, update: if writeEnabled() && (admin() && safeUpload(30));
      allow delete: if writeEnabled() && (admin());
    }

    match /board_members/{file=**} {
      allow read: if signedIn();
      allow write: if writeEnabled() && (manager() && (request.resource == null || safeUpload(8)));
    }

    match /services/{file=**} {
      allow read: if signedIn();
      allow write: if writeEnabled() && (manager() && (request.resource == null || safeUpload(8)));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
